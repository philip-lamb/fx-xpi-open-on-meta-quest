{
  "name": "fx-xpi-open-on-meta-quest",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox extension: open links on a Meta Quest headset via Meta Web Launch.",
  "scripts": {
    "start": "web-ext run --source-dir src --firefox=firefoxdeveloperedition --start-url https://www.meta.com/",
    "start:release": "web-ext run --source-dir src --firefox=firefox --start-url https://www.meta.com/",
    "lint": "web-ext lint --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest",
    "sign": "web-ext sign --source-dir src --artifacts-dir dist --channel listed"
  },
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
